{
  "name": "@study-app/api",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker (Hono) API for the study app.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@study-app/core": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
