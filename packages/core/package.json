{
  "name": "@study-app/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript FSRS/spaced-repetition core shared by the mobile app and the API.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "mathjs": "15.2.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
